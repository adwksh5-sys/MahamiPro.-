@charset "utf-8";

* { box-sizing: border-box; }

body { margin: 0px; padding: 20px 14px; background: rgb(11, 18, 32); color: rgb(255, 255, 255); font-family: Arial, sans-serif; }

.container { max-width: 520px; margin: auto; }

h1 { text-align: center; color: rgb(56, 189, 248); }

.subtitle { text-align: center; color: rgb(148, 163, 184); }

.panel { background: rgb(23, 35, 56); padding: 18px; border-radius: 15px; margin-top: 18px; }

input, select { width: 100%; padding: 13px; margin: 7px 0px; border: 1px solid rgb(51, 65, 85); border-radius: 10px; background: rgb(11, 18, 32); color: white; font-size: 15px; }

button { padding: 12px; border: 0px; border-radius: 10px; background: rgb(2, 132, 199); color: white; font-weight: bold; cursor: pointer; font-size: 14px; }

button:disabled { opacity: 0.5; }

.auth-buttons { display: flex; gap: 8px; margin-top: 10px; }

.auth-buttons button { flex: 1 1 0%; }

#logout { background: rgb(71, 85, 105); }

.stats { display: flex; gap: 8px; margin: 18px 0px; }

.card { background: rgb(23, 35, 56); padding: 14px 5px; border-radius: 12px; flex: 1 1 0%; text-align: center; }

.card strong { display: block; color: rgb(56, 189, 248); font-size: 24px; margin-bottom: 7px; }

ul { padding: 0px; }

li { background: rgb(23, 35, 56); padding: 14px; margin: 12px 0px; border-radius: 12px; list-style: none; }

.task-top { display: flex; justify-content: space-between; align-items: center; gap: 8px; }

.task-name { font-weight: bold; overflow-wrap: anywhere; }

.task-info { color: rgb(148, 163, 184); font-size: 12px; margin-top: 9px; }

.task-actions { display: flex; gap: 7px; margin-top: 12px; }

.task-actions button { flex: 1 1 0%; }

.done { text-decoration: line-through; color: rgb(100, 116, 139); }

.delete { background: rgb(220, 38, 38); }

.complete { background: rgb(5, 150, 105); }

#clear { width: 100%; margin-top: 15px; background: rgb(220, 38, 38); }

#status { text-align: center; color: rgb(148, 163, 184); font-size: 13px; margin: 20px 0px; }

.hidden { display: none !important; }

.link-button { background: transparent; color: rgb(56, 189, 248); padding: 12px 0px; }

.message { font-size: 13px; line-height: 1.7; overflow-wrap: anywhere; }

.empty { text-align: center; color: rgb(148, 163, 184); padding: 20px; }

label { display: block; margin-top: 10px; color: rgb(203, 213, 225); }

#app input, #app select { margin-bottom: 10px; }
