<body>
<div class="container">

<h1>Mahami Pro 🚀</h1>
<p class="subtitle">نظّم يومك وحقق أهدافك</p>

<div id="auth" class="panel">
  <h3>حسابك</h3>
  <input id="email" type="email" placeholder="البريد الإلكتروني">
  <input id="password" type="password" placeholder="كلمة المرور">

  <div class="auth-buttons">
    <button id="signupBtn">إنشاء حساب</button>
    <button id="loginBtn">تسجيل الدخول</button>
  </div>

  <button class="link-button" id="forgotBtn">نسيت كلمة المرور؟</button>
  <p id="authMessage" class="message"></p>
</div>

<div id="recovery" class="panel hidden">
  <h3>تعيين كلمة مرور جديدة 🔐</h3>
  <input id="newPassword" type="password" placeholder="كلمة المرور الجديدة">
  <input id="confirmPassword" type="password" placeholder="تأكيد كلمة المرور">
  <button id="changePasswordBtn">حفظ كلمة المرور</button>
  <p id="recoveryMessage" class="message"></p>
</div>

<div id="app" class="hidden">

  <div class="panel">
    <p id="welcome"></p>
    <button id="logout">تسجيل الخروج</button>
  </div>

  <div class="stats">
    <div class="card">
      <strong id="total">0</strong>
      المجموع
    </div>
    <div class="card">
      <strong id="completed">0</strong>
      مكتملة
    </div>
    <div class="card">
      <strong id="remaining">0</strong>
      متبقية
    </div>
  </div>

  <div class="panel">
    <h3>إضافة مهمة جديدة 📝</h3>
    <input id="task" placeholder="اكتب مهمتك هنا">

    <select id="category">
      <option value="شخصي">شخصي</option>
      <option value="دراسة">دراسة</option>
      <option value="شغل">شغل</option>
      <option value="صحة">صحة</option>
      <option value="أخرى">أخرى</option>
    </select>

    <select id="priority">
      <option value="عالية">أولوية عالية 🔴</option>
      <option value="متوسطة" selected="">أولوية متوسطة 🟡</option>
      <option value="منخفضة">أولوية منخفضة 🟢</option>
    </select>

    <label for="dueDate">تاريخ التسليم:</label>
    <input type="date" id="dueDate">

    <button id="addBtn">إضافة المهمة +</button>
  </div>

  <ul id="list"><li class="empty">لا توجد مهام حتى الآن 🌟</li></ul>
  <button id="clear">حذف كل المهام</button>
</div>

<p id="status">Mahami Pro جاهز ❤️</p>
</div>




</body></html>
